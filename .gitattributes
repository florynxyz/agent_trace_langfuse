# Force LF line endings for shell scripts (critical for Docker/Linux)
*.sh text eol=lf
**/entrypoint.sh text eol=lf

# Force LF for Docker and CI/CD files
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# Auto detect other text files
* text=auto

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

